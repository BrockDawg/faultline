# Secret-hygiene ignores.
# Reduces accidental staging of secret-NAMED files. It does NOT catch an in-file paste
# or anything already tracked — that needs the secret scan + pre-commit hook.
.env*
*.pem
*.key
*credentials*
client_secret*.json
*token*.json
.mcp.json
*.mcp.json
.mcp.local.json

# --- Kept local ---
.planning/
STATE.md
CLAUDE.md
AGENTS.md

# --- Never commit run output, data, corpus or video ---
runs/
data/
corpus/
kept-from-tasks/
*.jsonl
*.mp4
*.mov
*.mkv
*.webm
*.avi

# --- Python build and test output ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
